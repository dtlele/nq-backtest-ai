# .gitignore

# Secrets
.env

# Python caches
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp

# Large data files (consider Git LFS)
*.csv

# OS generated files
.DS_Store
Thumbs.db

# Notebook checkpoints
.ipynb_checkpoints/

# Local workspace caches and DBs
agent_memory/
agent_memory_v1/
dashboard/node_modules/
database.db
.claude/
tmp_data/
output/

# Large binary data files (not committed)
data/options_qqq/QQQ_options_full.parquet
data/options_qqq/QQQ_underlying.parquet

# Video analysis
data/video_analysis/fabio_v1_full.mp4
data/video_analysis/*.html

.env.backup
*.backup
